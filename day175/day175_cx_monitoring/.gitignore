# Virtual environments (any name pattern)
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.python-version
*.egg-info/
.eggs/
dist/
build/

# Tests / tooling cache
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Local server state & logs (optional)
.server.pid
logs/
*.log

# Node / front-end toolchain (when added)
node_modules/

# Editors & OS junk
.idea/
.vscode/
*.swp
.DS_Store

# Environment files (secrets must never be committed — this project ships without keys)
.env
.env.*
!.env.example

# Accidental infra manifests (exclude if pasted into demo tree)
**/istio**/
istio/
*istio*
